{
  "name": "ioniclink-v2",
  "version": "0.2.0",
  "private": true,
  "description": "Compact system for extracting standardized ionic-liquid tribology data from scientific papers.",
  "scripts": {
    "dev": "node scripts/next-with-dist-dir.mjs .next-dev dev",
    "dev:frontend": "node scripts/next-with-dist-dir.mjs .next-dev dev -H 127.0.0.1 -p 3000",
    "dev:api-proxy": "node scripts/dev-api-proxy.mjs --host 127.0.0.1 --port 8000 --target http://127.0.0.1:3000",
    "build": "node scripts/next-with-dist-dir.mjs .next build",
    "start": "node scripts/next-with-dist-dir.mjs .next start",
    "lint": "next lint",
    "seed": "tsx scripts/seed.ts",
    "seed:conductivity": "tsx scripts/seed.conductivity.ts",
    "seed:diffusion": "tsx scripts/seed.diffusion.ts",
    "migrate": "tsx scripts/migrate-domains.ts",
    "migrate:structures": "tsx scripts/backfill-structure-keys.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:file": "node scripts/run-tests.mjs",
    "check:fast": "npm run lint && npm run typecheck",
    "check": "npm run check:fast && npm test && npm run build",
    "test:wff-repro": "python3 scripts/wff_paper_reproduction_test.py",
    "wff:reproduce": "python3 scripts/wff_paper_reproduction.py",
    "wff:hybrid-search": "python3 scripts/wff_paper_reproduction.py --mode hybrid-search --search-preset meta-targeted",
    "wff:prewarm": "tsx scripts/prewarm-wff-strategy-cache.ts",
    "wff:prewarm:student-grid": "tsx scripts/prewarm-wff-strategy-cache.ts --student-grid",
    "wff:prewarm:server": "node scripts/prewarm-wff-strategy-cache.mjs --student-grid --server-url=http://127.0.0.1:3000"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@napi-rs/canvas": "^0.1.100",
    "better-auth": "^1.6.26",
    "better-sqlite3": "^12.11.1",
    "exceljs": "^4.4.0",
    "ketcher-core": "3.17.1",
    "ketcher-react": "3.17.1",
    "ketcher-standalone": "3.17.1",
    "next": "14.2.35",
    "openchemlib": "9.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smiles-drawer": "^2.1.7",
    "unpdf": "^1.3.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.32",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
