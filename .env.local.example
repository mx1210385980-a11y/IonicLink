# Copy to .env.local and fill in to enable live AI extraction.
# Without a key, the Extract page falls back to a deterministic mock extractor.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional fallback for Anthropic's native API.
ANTHROPIC_API_KEY=

# Model used for extraction. Sonnet balances speed and quality for throughput.
EXTRACT_MODEL=claude-sonnet-4-6

# Number of papers extracted in parallel from the batch queue (default 4, max 16).
# Raise it if your API tier allows more simultaneous requests; lower it if you hit rate limits.
EXTRACT_CONCURRENCY=4

# Teacher login for the zero-configuration AI-vs-manual classroom experiment.
# Use a long unique value in production. Students use only a pseudonymous ID; they do not
# need this password, an invite code, or a group code. Frozen teaching AI suggestions work
# without a live extraction API key.
TEACHING_TEACHER_PASSWORD=

# Optional local/development override for all runtime SQLite files, including teaching.db.
# Leave unset to use <repository>/data. Production Docker uses its managed /app/data mount.
# IONICLINK_DATA_DIR=/absolute/path/to/ioniclink-data
