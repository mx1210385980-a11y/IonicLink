# Copy to .env.local and fill in to enable live AI extraction.
# Without a key, the Extract page falls back to a deterministic mock extractor.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional fallback for Anthropic's native API.
ANTHROPIC_API_KEY=

# Model used for extraction. Sonnet balances speed and quality for throughput.
EXTRACT_MODEL=claude-sonnet-4-6

# Number of papers extracted in parallel from the batch queue (default 4, max 16).
# Raise it if your API tier allows more simultaneous requests; lower it if you hit rate limits.
EXTRACT_CONCURRENCY=4
