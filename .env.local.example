# Copy to .env.local and fill in one provider to enable live AI extraction.
KIMI_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional fallback for Anthropic's native API.
ANTHROPIC_API_KEY=

# Model used for extraction. Sonnet balances speed and quality for throughput.
EXTRACT_MODEL=claude-sonnet-4-6

# PDF figure extraction is automatic for known vision models (including kimi-k3).
# Set EXTRACT_VISION_MODE=off to disable, or on to force it for a compatible custom model.
EXTRACT_VISION_MODE=auto
EXTRACT_VISUAL_PAGE_LIMIT=3
EXTRACT_VISUAL_PAGE_SCALE=3

# Number of papers extracted in parallel from the batch queue (default 8, max 16).
# Raise it if your API tier allows more simultaneous requests; lower it if you hit rate limits.
EXTRACT_CONCURRENCY=8

# Optional general application login (separate from the teaching lab).
# Leave both values blank to keep the workspace public. To enable login, set both values,
# use a unique secret of at least 32 characters, and use the public HTTPS origin in production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Used only when application login is enabled. Self-registration is convenient locally; keep it
# false in production unless every visitor should be able to create an account.
IONICLINK_ALLOW_SIGNUP=true

# Optional one-time production bootstrap administrator. Set email and password together.
# After the first successful startup, remove the password from the environment and restart.
# The password must contain 8-128 characters.
IONICLINK_BOOTSTRAP_EMAIL=
IONICLINK_BOOTSTRAP_PASSWORD=
IONICLINK_BOOTSTRAP_NAME=IonicLink Administrator

# Password for the retained teaching-session login API; use a long unique value if used.
# The current /teaching instructor entry is open and does not check this setting or general
# application login. Restricted teaching deployments need separate access control.
# The teacher creates a paper experiment first; students choose AI or manual extraction
# and receive an automatic ID. The AI group requires a live extraction provider configured above.
TEACHING_TEACHER_PASSWORD=

# Optional local/development override for all runtime SQLite files, including auth.db and teaching.db.
# Leave unset to use <repository>/data. Production Docker uses its managed /app/data mount.
# IONICLINK_DATA_DIR=/absolute/path/to/ioniclink-data
